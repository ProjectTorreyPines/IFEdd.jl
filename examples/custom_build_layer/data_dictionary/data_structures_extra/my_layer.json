  "data_type": "FLT_0D",
  "documentation": "Radial thickness of the layer",
  "type": "static",
  "units": "m"
 },
 "my_layer[:].type": {
  "data_type": "INT_0D",
  "documentation": "Layer type code (follows BuildLayerType convention)\n-1) plasma/chamber (target ignition zone)\n0) gap (void/vacuum)\n3) shield\n4) blanket\n5) wall (first wall)\n6) vessel",
  "type": "static"
 },
 "my_layer[:].volume": {
  "data_type": "FLT_0D",
  "documentation": "Volume of the layer",
  "type": "static",
  "units": "m^3"
 }
