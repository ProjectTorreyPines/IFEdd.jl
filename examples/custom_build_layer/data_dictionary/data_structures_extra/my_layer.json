  "units": "m^2"
 },
 "my_layer[:].cost_rate": {
  "data_type": "FLT_0D",
  "documentation": "Fabrication cost per unit volume of this layer",
  "type": "static",
  "units": "USD/m^3"
 },
 "my_layer[:].end_radius": {
  "data_type": "FLT_0D",
  "documentation": "Outer radius of the layer",
  "type": "static",
  "units": "m"
 },
 "my_layer[:].material": {
  "data_type": "STR_0D",
  "documentation": "Material of the layer",
  "type": "static"
 },
 "my_layer[:].name": {
  "data_type": "STR_0D",
  "documentation": "Name of the layer",
  "type": "static"
 },
 "my_layer[:].outline": {
  "_supertype": "AbstractIFEBuildLayerOutline",
  "data_type": "STRUCTURE",
  "documentation": "Poloidal cross-section outline of the layer boundary"
